{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(vp check:*)",
            "Bash(vp test:*)",
            "Bash(vp lint:*)",
            "Bash(vp fmt:*)",
            "Bash(vp run build)",
            "Bash(vp run test:e2e)",
            "Bash(vp run test:unit)",
            "Bash(vp run lint:fsd)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ],
        "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
    }
}
