# Backend / API address (the most common one)
VITE_API_URL=/api/v1
# Socket.IO server URL. Empty = same origin as the app (through the dev proxy)
VITE_SOCKET_URL=

# App info
VITE_APP_NAME=React Starter
VITE_APP_VERSION=0.0.0
VITE_APP_ENV=development

# no VITE_ prefix = not sent to browser
PORT=5173
API_PROXY_TARGET=http://localhost:3000
SOCKET_PROXY_TARGET=http://localhost:3000
